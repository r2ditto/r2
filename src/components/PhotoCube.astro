---
import type { GalleryItem } from "@lib/timeline-gallery";
import type { CollectionEntry } from "astro:content";

interface Props {
  // Each photo occupies one tile; remaining tiles use muted colors.
  items: GalleryItem[];
  posts: CollectionEntry<"notes">[];
}

const { items, posts } = Astro.props;
const renderedPosts = await Promise.all(
  posts.map(async (post) => ({ post, Content: (await post.render()).Content })),
);
---

<photo-cube data-items={JSON.stringify(items)}>
  <div class="stage" aria-hidden="true"></div>

  <div class="photo-blob" aria-hidden="true">
    <div class="tracker-link"></div>
    <div class="tracker-pointer"></div>
    <div class="tracker-box"><canvas class="tracker-pixels" width="8" height="8"></canvas><span class="tracker-coordinates"></span><span class="tracker-crosshair">•</span></div>
    <div class="blob-surface">
      <h2 class="blob-heading"></h2>
      <p class="blob-subtitle"></p>
    </div>
  </div>

  <div class="cube-controls" hidden>
    <button class="cube-action" type="button" data-action="rebuild">
      <span class="action-icon" aria-hidden="true">
        <span class="icon-fallback icon-fallback--explode">✷</span>
        <span class="icon-fallback icon-fallback--rebuild">◇</span>
        <span class="icon-lottie icon-lottie--explode"></span>
        <span class="icon-lottie icon-lottie--rebuild"></span>
      </span>
      <span class="cube-action-label">Rebuild</span>
    </button>
  </div>

  <ul class="sr-only">
    {
      posts.map((post) => (
        <li>
          <h2><a href={`/notes/${post.slug}/`}>{post.data.title}</a></h2>
          <p>{post.data.description}</p>
        </li>
      ))
    }
  </ul>

  <dialog class="details" aria-labelledby="post-title">
    <header class="post-bar">
      <span>R2 / Field notes</span>
      <button class="close" type="button" autofocus aria-label="Close article (Escape)">
        Escape
        <svg viewBox="0 0 20 20" width="20" height="20" fill="none" aria-hidden="true">
          <path d="M4 4 16 16M16 4 4 16" stroke="currentColor" stroke-width="1" stroke-linecap="round" />
        </svg>
      </button>
    </header>
    <article class="post-article">
      <div class="post-heading">
        <p class="details-index"></p>
        <h2 id="post-title" class="details-title"></h2>
      </div>
      <figure class="post-figure">
        <img class="post-image" src={items[0]?.src ?? ""} alt="" />
      </figure>
      <div class="post-body">
        {renderedPosts.map(({ post, Content }) => (
          <div class="post-content" data-post-slug={post.slug} hidden>
            <Content />
          </div>
        ))}
        <footer class="post-end">End of note — R2 / Ruin &amp; Rebuild</footer>
      </div>
    </article>
  </dialog>
</photo-cube>

<style>
  photo-cube {
    position: absolute;
    inset: 0;
    display: block;
  }

  .stage {
    position: absolute;
    inset: 0;
  }

  .stage :global(canvas) {
    display: block;
    touch-action: none;
    cursor: grab;
  }

  .stage :global(canvas.is-dragging) {
    cursor: grabbing;
  }

  .photo-blob {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 3;
    width: 0;
    height: 0;
    color: #181715;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity 120ms ease, visibility 120ms;
    will-change: transform;
  }

  .photo-blob.is-visible { opacity: 1; visibility: visible; }

  .tracker-box {
    position: absolute;
    left: -36px;
    top: -24px;
    width: 72px;
    height: 48px;
    box-sizing: border-box;
    border: 1px solid currentColor;
    background: #ffffff0d;
  }

  .tracker-pixels {
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    filter: grayscale(1);
    opacity: 0.6;
  }

  .tracker-link {
    position: absolute;
    height: 1px;
    background: #18171599;
    transform-origin: 0 50%;
  }

  .tracker-pointer {
    position: absolute;
    width: 18px;
    height: 26px;
    border: 1px solid #181715bb;
    background: repeating-conic-gradient(#18171533 0% 25%, #18171500 0% 50%) 0 / 8px 8px;
    box-sizing: border-box;
  }

  .tracker-coordinates {
    position: absolute;
    left: -1px;
    bottom: 100%;
    padding: 2px 4px;
    background: #181715dd;
    color: #fff;
    white-space: nowrap;
    font: 9px/1.2 "Geist Mono", monospace;
    letter-spacing: 0.06em;
  }

  .tracker-crosshair {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font: 14px/1 "Geist Mono", monospace;
  }

  .blob-surface {
    position: absolute;
    width: min(220px, calc(100vw - 32px));
    box-sizing: border-box;
    padding: 10px 12px;
    border-left: 1px solid currentColor;
    background: #111e;
    color: #fff;
  }

  .blob-heading {
    margin: 0 0 6px;
    font: 0.8rem/1.2 "Geist Mono", monospace;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .blob-subtitle {
    margin: 0;
    color: #ddd;
    font: 0.65rem/1.55 "Geist Mono", monospace;
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-blob { transition: none; }
  }

  .cube-controls {
    position: absolute;
    z-index: 1;
    bottom: max(6.5rem, 12vh);
    left: 1rem;
    right: 1rem;
    text-align: center;
    font: 0.7rem/1.6 "Geist Mono", monospace;
    color: #514d45;
    pointer-events: none;
  }

  .cube-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    min-height: 44px;
    padding: 0.5rem 1rem;
    border: 0;
    border-radius: 0;
    background: #e7e2d7;
    color: #181715;
    font: inherit;
    text-transform: uppercase;
    cursor: pointer;
    pointer-events: auto;
  }

  .cube-action:hover { background: #f8f5ee; }
  .cube-action:focus-visible { outline: 2px solid #181715; outline-offset: 4px; }
  .cube-action:disabled { opacity: 0.5; cursor: wait; }

  .action-icon {
    position: relative;
    display: inline-block;
    width: 58px;
    height: 40px;
    flex: none;
  }
  .icon-lottie, .icon-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .icon-fallback {
    color: #c64b20;
    font: 1.35rem/1 "Instrument Serif", serif;
  }
  .cube-action[data-action="rebuild"] .icon-lottie--explode,
  .cube-action[data-action="rebuild"] .icon-fallback--explode,
  .cube-action[data-action="explode"] .icon-lottie--rebuild,
  .cube-action[data-action="explode"] .icon-fallback--rebuild { display: none; }
  .cube-action[data-action="explode"] .action-icon.is-explode-loaded .icon-fallback--explode,
  .cube-action[data-action="rebuild"] .action-icon.is-rebuild-loaded .icon-fallback--rebuild { display: none; }
  .icon-lottie :global(svg) { width: 100%; height: 100%; }
  .details {
    position: fixed;
    inset: 0;
    width: calc(100vw - 48px);
    height: calc(100dvh - 48px);
    max-width: none;
    max-height: none;
    box-sizing: border-box;
    margin: auto;
    padding: 0;
    border: 0;
    background: rgb(8 8 8 / 20%);
    color: #fff;
    overflow: auto;
    overscroll-behavior: contain;
  }
  .details::backdrop {
    background: rgb(8 8 8 / 42%);
    backdrop-filter: blur(5px);
  }
  .details[open] { animation: post-in 220ms ease-out; }
  .post-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px clamp(20px, 4vw, 64px);
    font: 0.7rem "Geist Mono", monospace;
    text-transform: uppercase;
  }
  .close {
    display: flex;
    align-items: center;
    gap: 18px;
    min-height: 44px;
    border: 0;
    padding: 0 4px;
    color: inherit;
    background: none;
    font: inherit;
    text-transform: uppercase;
    cursor: pointer;
  }
  .close svg { flex: none; }
  .close:hover { opacity: 0.6; }
  .close:focus-visible { outline: none; text-decoration: underline; text-underline-offset: 4px; }
  .post-article { max-width: 1200px; margin: auto; padding: clamp(32px, 6vw, 88px) clamp(20px, 5vw, 80px); }
  .post-heading { max-width: 820px; margin-bottom: 40px; }
  .details-index { margin: 0 0 24px; font: 0.65rem/1.6 "Geist Mono", monospace; text-transform: uppercase; letter-spacing: 0.08em; }
  .details-title { margin: 0 0 24px; font: 400 clamp(3.5rem, 8vw, 7.5rem)/0.95 "Instrument Serif", serif; letter-spacing: -0.035em; overflow-wrap: anywhere; }
  .post-figure { margin: 0 0 56px; }
  .post-image { display: block; width: 100%; max-height: 65vh; aspect-ratio: 16 / 10; object-fit: cover; background: #d8d3c9; }
  figcaption { margin-top: 12px; color: #ddd; font: 0.65rem/1.5 "Geist Mono", monospace; }
  .post-body { max-width: 680px; margin: auto; font: 1rem/1.85 system-ui, sans-serif; }
  .post-body :global(p) { margin: 0 0 24px; }
  .post-body :global(.post-content > p:first-child) { font-size: 1.25rem; line-height: 1.65; }
  .post-body :global(h2) { margin: 48px 0 20px; font: 400 2.5rem/1.1 "Instrument Serif", serif; }
  .post-body :global(blockquote) { margin: 36px 0; padding-left: 20px; border-left: 1px solid #ffffff88; font-style: italic; }
  blockquote { margin: 40px 0; padding-left: 24px; border-left: 1px solid #777; font: italic 2rem/1.3 "Instrument Serif", serif; }
  .post-end { margin-top: 64px; padding-top: 24px; border-top: 1px solid #ffffff44; font: 0.65rem/1.6 "Geist Mono", monospace; text-transform: uppercase; }
  @keyframes post-in { from { opacity: 0; transform: translateY(12px); } }
  @media (max-width: 640px) {
    .details { width: calc(100vw - 16px); height: calc(100dvh - 16px); }
    .post-figure { margin-bottom: 32px; }
  }
  @media (prefers-reduced-motion: reduce) { .details[open] { animation: none; } }

</style>

<script>
  import type { GalleryItem } from "@lib/timeline-gallery";
  import type { PhotoCube } from "@lib/photo-cube";
  import rebuildAnimation from "@lib/rebuild-lottie.json";

  class PhotoCubeElement extends HTMLElement {
    private cube?: PhotoCube;
    private ready?: Promise<PhotoCube | undefined>;
    private actionAnimations: { destroy(): void }[] = [];

    connectedCallback() {
      const stage = this.querySelector<HTMLElement>(".stage");
      const items: GalleryItem[] = JSON.parse(this.dataset.items ?? "[]");
      if (!stage || items.length === 0) return;

      // Three.js is heavy; load it after the rest of the page is up
      this.ready = import("@lib/photo-cube").then(({ PhotoCube }) => {
        if (!this.isConnected) return undefined;
        this.cube = new PhotoCube(stage, items);
        this.bindControls();
        return this.cube;
      });

      this.bindDetails(items);
      this.bindBlob(items);
      void this.bindActionAnimations();

    }

    disconnectedCallback() {
      this.cube?.destroy();
      this.actionAnimations.forEach((animation) => animation.destroy());
      this.actionAnimations = [];
    }

    private async bindActionAnimations() {
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      const icon = this.querySelector<HTMLElement>(".action-icon");
      if (!icon) return;
      const { default: lottie } = await import("lottie-web");
      if (!this.isConnected) return;
      for (const action of ["explode", "rebuild"] as const) {
        const container = icon.querySelector<HTMLElement>(`.icon-lottie--${action}`);
        if (!container) continue;
        const animation = lottie.loadAnimation({
          container,
          renderer: "svg",
          loop: true,
          autoplay: true,
          ...(action === "explode"
            ? { path: "/explosion-lottie.json" }
            : { animationData: rebuildAnimation }),
          rendererSettings: { preserveAspectRatio: "xMidYMid meet" },
        });
        animation.setSpeed(action === "explode" ? 0.5 : 1);
        animation.addEventListener("DOMLoaded", () => icon.classList.add(`is-${action}-loaded`));
        this.actionAnimations.push(animation);
      }
    }

    // Pull an exploded cube back together
    async rebuild(): Promise<void> {
      const cube = await this.ready;
      return cube?.rebuild();
    }

    // Share of the cube that's been wrecked (0..1)
    get ruinLevel() {
      return this.cube?.ruinLevel ?? 0;
    }

    private bindControls() {
      const controls = this.querySelector<HTMLElement>(".cube-controls")!;
      const button = controls.querySelector<HTMLButtonElement>(".cube-action")!;
      const label = button.querySelector<HTMLElement>(".cube-action-label")!;
      controls.hidden = false;
      let state = "exploded";
      this.addEventListener("gallery:ruin", (event) => {
        state = (event as CustomEvent<{ state: string }>).detail.state;
        button.disabled = state === "rebuilding";
        button.dataset.action = state === "intact" ? "explode" : "rebuild";
        label.textContent = state === "intact" ? "Explode cube" : state === "rebuilding" ? "Rebuilding…" : "Rebuild";
      });
      button.addEventListener("click", () => {
        if (state === "intact") this.cube?.explode();
        else if (state === "exploded") void this.rebuild();
      });
    }

    private bindBlob(items: GalleryItem[]) {
      const blob = this.querySelector<HTMLElement>(".photo-blob")!;
      const surface = blob.querySelector<HTMLElement>(".blob-surface")!;
      const coordinates = blob.querySelector<HTMLElement>(".tracker-coordinates")!;
      const heading = blob.querySelector<HTMLElement>(".blob-heading")!;
      const subtitle = blob.querySelector<HTMLElement>(".blob-subtitle")!;
      const box = blob.querySelector<HTMLElement>(".tracker-box")!;
      const marker = blob.querySelector<HTMLElement>(".tracker-pointer")!;
      const line = blob.querySelector<HTMLElement>(".tracker-link")!;
      const pixels = blob.querySelector<HTMLCanvasElement>(".tracker-pixels")!;
      const context = pixels.getContext("2d")!;
      const thumbnails = new Map<string, HTMLImageElement>();
      let previous: number | null = null;
      this.addEventListener("cube:hover", (event) => {
        const { index, x, y, bounds } = (event as CustomEvent<{
          index: number | null; x: number; y: number;
          bounds: { x: number; y: number; width: number; height: number } | null;
        }>).detail;
        const item = index === null ? null : items[index];
        blob.classList.toggle("is-visible", !!item);
        if (!item || !bounds) { previous = null; return; }
        if (index !== previous) {
          heading.textContent = item.title ?? item.caption ?? "";
          subtitle.textContent = item.text ?? "";
          previous = index;
          context.clearRect(0, 0, 8, 8);
          let image = thumbnails.get(item.src);
          const paint = (image: HTMLImageElement) => {
            if (previous !== index) return;
            const size = Math.min(image.naturalWidth, image.naturalHeight);
            context.drawImage(image, (image.naturalWidth - size) / 2, (image.naturalHeight - size) / 2, size, size, 0, 0, 8, 8);
          };
          if (!image) {
            image = new Image();
            thumbnails.set(item.src, image);
            image.src = item.src;
          }
          if (image.complete && image.naturalWidth) paint(image);
          else image.addEventListener("load", () => paint(image!), { once: true });
        }
        const centerX = bounds.x + bounds.width / 2;
        const centerY = bounds.y + bounds.height / 2;
        blob.style.transform = `translate3d(${centerX}px, ${centerY}px, 0)`;
        box.style.left = `${-bounds.width / 2}px`;
        box.style.top = `${-bounds.height / 2}px`;
        box.style.width = `${bounds.width}px`;
        box.style.height = `${bounds.height}px`;
        const dx = x - centerX;
        const dy = y - centerY;
        marker.style.transform = `translate(${dx - 9}px, ${dy - 13}px)`;
        line.style.width = `${Math.hypot(dx, dy)}px`;
        line.style.transform = `rotate(${Math.atan2(dy, dx)}rad)`;
        const width = surface.offsetWidth;
        const height = surface.offsetHeight;
        const right = bounds.x + bounds.width + 16;
        const left = right + width > this.clientWidth - 16 ? bounds.x - width - 16 : right;
        const top = Math.max(16, Math.min(bounds.y, this.clientHeight - height - 16));
        coordinates.textContent = `TRACK ${String(index! + 1).padStart(2, "0")}`;
        surface.style.transform = `translate(${Math.max(16, left) - centerX}px, ${top - centerY}px)`;
      });
    }

    private bindDetails(items: GalleryItem[]) {
      const panel = this.querySelector<HTMLDialogElement>(".details")!;
      const title = panel.querySelector(".details-title")!;
      const index = panel.querySelector(".details-index")!;
      const image = panel.querySelector<HTMLImageElement>(".post-image")!;
      const postContents = panel.querySelectorAll<HTMLElement>(".post-content");

      this.addEventListener("cube:select", (e) => {
        const i = (e as CustomEvent<{ index: number | null }>).detail.index;
        const item = i === null ? null : items[i];
        if (!item || i === null) {
          if (panel.open) panel.close();
          return;
        }
        title.textContent = item.title ?? item.caption ?? "";
        index.textContent = item.caption ?? "Field notes";
        image.src = item.src;
        image.alt = item.imageAlt ?? item.title ?? item.caption ?? "Visual study";
        postContents.forEach((content) => {
          content.hidden = content.dataset.postSlug !== item.postSlug;
        });
        if (!panel.open) panel.showModal();
        panel.scrollTop = 0;
      });

      panel.querySelector(".close")!.addEventListener("click", () => panel.close());
      panel.addEventListener("close", () => this.cube?.select(null));
    }
  }

  customElements.define("photo-cube", PhotoCubeElement);
</script>
