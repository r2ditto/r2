---
import PosterLayout from "@layouts/PosterLayout.astro";
import PhotoCube from "@components/PhotoCube.astro";
import Crumble from "@components/Crumble.astro";
import { galleryFromPosts } from "@data/gallery";
import { getCollection } from "astro:content";
import { HOME, SITE, SOCIALS } from "@consts";

const year = new Date().getFullYear();
const posts = (await getCollection("notes", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const gallery = galleryFromPosts(posts);
---

<PosterLayout title={SITE.TITLE} description={HOME.DESCRIPTION}>
  <main class="poster">
    <div class="handwriting" aria-hidden="true">
      <svg class="handwriting-archive" viewBox="40 650 1968 680" width="1968" height="680" focusable="false">
        <image href="/handwritten-archive.png" width="2048" height="2048" />
      </svg>
      <svg class="handwriting-signature" viewBox="400 800 1000 500" width="1000" height="500" focusable="false">
        <image href="/handwritten-signature.png" width="2048" height="2048" />
      </svg>
    </div>
    <p class="sr-only">An archive of ideas, images, and projects caught in a loop of decay and becoming. — Ryan Rey</p>

    <PhotoCube items={gallery} posts={posts} />

    <header class="corner top-left">
      <h1 class="title"><Crumble text="Ruin & Rebuild" italicInitials /></h1>
      <p class="label"><Crumble text="R2 / Frontend Developer" /></p>
      <p class="label dim"><Crumble text={String(year)} /></p>
    </header>

    <div class="corner top-right">
      <p class="label"><Crumble text="r-2.io" /></p>
      <button class="label rebuild" type="button" hidden>Rebuild</button>
    </div>

    <div class="corner bottom-left">
      <p class="label"><Crumble text="-79.3832 / 43.6532" /></p>
    </div>

    <nav class="corner bottom-center" aria-label="Social">
      {
        SOCIALS.map((social) => (
          <a class="label" href={social.HREF} target="_blank" rel="noopener">
            <Crumble text={social.NAME} />
          </a>
        ))
      }
    </nav>

    <footer class="corner bottom-right">
      <p class="label"><Crumble text={`© ${year} R2`} /></p>
      <p class="label dim"><Crumble text="Ryan Rey" /></p>
    </footer>
  </main>
</PosterLayout>

<style>
  .poster {
    position: relative;
    height: 100dvh;
    overflow: hidden;
    color: #181715;
    background-color: #e7e2d7;
    background-image:
      url("/paper-grain.svg"),
      radial-gradient(ellipse at 12% 18%, #564f4024, transparent 34%),
      radial-gradient(ellipse at 86% 82%, #80745c1f, transparent 38%),
      radial-gradient(ellipse at 50% 48%, #f8f5ee 5%, transparent 75%);
    background-size: 512px 512px, cover, cover, cover;
  }

  .handwriting {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    mix-blend-mode: multiply;
  }

  .handwriting-archive,
  .handwriting-signature {
    position: absolute;
    display: block;
    height: auto;
  }

  .handwriting-archive {
    top: 47%;
    left: 50%;
    width: min(88vw, 1400px);
    transform: translate(-50%, -50%) rotate(-1.5deg);
    opacity: 0.76;
  }

  .handwriting-signature {
    right: clamp(16px, 8vw, 150px);
    bottom: clamp(88px, 13vh, 160px);
    width: clamp(210px, 31vw, 380px);
    transform: rotate(-5deg);
    opacity: 0.88;
  }

  .corner {
    position: absolute;
    z-index: 1;
    pointer-events: none;
  }

  .corner a,
  .corner button {
    pointer-events: auto;
  }

  .top-left {
    top: 1.25rem;
    left: 1.5rem;
  }

  .top-right {
    top: 1.25rem;
    right: 1.5rem;
    text-align: right;
    /* Align with the subtitle row under the title */
    padding-top: clamp(2.75rem, 7.5vw, 6.5rem);
  }

  .bottom-left {
    bottom: 1.25rem;
    left: 1.5rem;
  }

  .bottom-center {
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 1.25rem;
  }

  .bottom-right {
    bottom: 1.25rem;
    right: 1.5rem;
    text-align: right;
  }

  .title {
    margin: 0 0 0.5rem;
    font-family: "Instrument Serif", serif;
    font-weight: 400;
    font-size: clamp(2.5rem, 7vw, 6rem);
    line-height: 0.9;
    letter-spacing: -0.02em;
    cursor: default;
  }

  .label {
    margin: 0;
    font-family: "Geist Mono", monospace;
    font-size: clamp(0.7rem, 1vw, 0.875rem);
    line-height: 1.3;
    text-transform: uppercase;
    color: #181715;
    text-decoration: none;
  }

  .rebuild {
    margin-top: 0.25rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    opacity: 0.55;
  }

  .rebuild:hover,
  .rebuild.is-total {
    opacity: 1;
  }

  /* Everything is broken: the whole poster takes a hit */
  .poster:global(.is-shaking) {
    animation: shake 450ms cubic-bezier(.36, .07, .19, .97);
  }

  @keyframes shake {
    10%, 90% { transform: translate(-2px, 1px); }
    20%, 80% { transform: translate(4px, -2px); }
    30%, 50%, 70% { transform: translate(-7px, 3px); }
    40%, 60% { transform: translate(7px, -3px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .poster:global(.is-shaking) {
      animation: none;
    }
  }

  a.label:hover,
  .rebuild:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .dim {
    opacity: 0.55;
  }

  @media (max-width: 640px) {
    .handwriting-archive {
      top: 43%;
      width: 92vw;
      transform: translate(-50%, -50%) rotate(-1deg);
    }

    .handwriting-signature {
      right: 6vw;
      bottom: 17vh;
      width: 55vw;
    }

    .bottom-center {
      bottom: 3.5rem;
      left: 1.5rem;
      transform: none;
      gap: 0.75rem;
    }
  }
</style>

<script>
  import { Crumble } from "@lib/crumble";
  import { initRuin, type RuinableGallery } from "@lib/ruin";

  let ruin: ReturnType<typeof initRuin> | null = null;
  const crumbles = [...document.querySelectorAll<HTMLElement>("[data-crumble]")].map(
    (el) => new Crumble(el, () => ruin?.update()),
  );

  ruin = initRuin({
    gallery: document.querySelector<RuinableGallery>("photo-cube"),
    crumbles,
    button: document.querySelector<HTMLButtonElement>(".rebuild"),
    poster: document.querySelector<HTMLElement>(".poster"),
  });
</script>
