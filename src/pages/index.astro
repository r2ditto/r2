---
import { sanityClient } from "sanity:client";
import type { SanityDocument } from "@sanity/client";

import ArrowCard from "@components/ArrowCard.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import Layout from "@layouts/Layout.astro";

import { HOME, SITE, SOCIALS } from "@consts";

import type { SanityPostEntry } from "@components/ArrowCard.astro";

const POSTS_QUERY = `*[
  _type == "post"
  && defined(slug.current)
  && !(_id in path('drafts.**'))
]|order(publishedAt desc)[0...${SITE.NUM_POSTS_ON_HOMEPAGE}]{
  _id,
  title,
  slug,
  publishedAt,
  description
}`;

const recentPosts = await sanityClient.fetch<SanityDocument[]>(POSTS_QUERY);
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <div class="space-y-12 mt-4" data-pagefind-ignore>
        <section class="animate space-y-6">
          <h2 class="font-semibold text-black dark:text-white">
            About
          </h2>
          <p>
            Frontend developer and e-commerce enthusiast based in Toronto, Canada. I specialize in the intersection of design, code, and commerce. My goal is to ensure that eye catching visuals never comes at the cost of functional performance. By integrating data-driven decision-making into the development lifecycle, I help brands build products that don't just look great, but convert better and scale faster.
          </p>
          
          <p>
            <u><i>Informed by full-stack breadth, driven by frontend depth.</i></u>
          </p>
        </section>

        <section class="animate space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-y-2">
            <h2 class="font-semibold text-black dark:text-white">
              Latest notes
            </h2>
          </div>
          <ul class="not-prose flex flex-col gap-4">
            {
              recentPosts.map((post) => {
                const entry: SanityPostEntry = {
                  collection: "notes",
                  slug: post.slug?.current ?? "",
                  data: {
                    title: post.title ?? null,
                    description: post.description ?? null,
                  },
                };
                return (
                  <li>
                    <ArrowCard entry={entry} />
                  </li>
                );
              })
            }
          </ul>
        </section>

        <section class="animate">
          <h2 class="font-semibold text-black dark:text-white">
            Socials
          </h2>

          <ul class="not-prose flex flex-wrap gap-2">
            {
              SOCIALS.map((SOCIAL) => (
                <li class="flex gap-x-2 text-nowrap">
                  <Link
                    href={SOCIAL.HREF}
                    external
                    aria-label={`${SITE.TITLE} on ${SOCIAL.NAME}`}
                  >
                    {SOCIAL.NAME}
                  </Link>
                </li>
              ))
            }
          </ul>
        </section>
    </div>
  </Container>
</Layout>
