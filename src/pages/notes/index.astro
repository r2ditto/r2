---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";

const posts = (await getCollection("notes", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title="Blog Posts" description="Latest blog posts">
  <Container>
    <h1 class="animate mb-8 text-4xl font-bold text-black dark:text-white">Posts</h1>
    <ul class="animate flex flex-col gap-y-4">
      {posts.map((post) => (
        <li class="group rounded-lg border border-black/10 bg-white p-4 transition-colors hover:border-black/20 dark:border-white/10 dark:bg-white/5 dark:hover:border-white/20">
          <a href={`/notes/${post.slug}/`}>
            <h2 class="text-xl font-semibold text-black group-hover:underline dark:text-white">{post.data.title}</h2>
            <p class="mt-1 text-black/60 dark:text-white/60">{post.data.description}</p>
            <p class="mt-2 text-sm text-black/40 dark:text-white/40">{post.data.date.toLocaleDateString("en-US", { timeZone: "UTC" })}</p>
          </a>
        </li>
      ))}
    </ul>
  </Container>
</Layout>
